--Sort orders by total amount ascending.

SELECT *
FROM am_orders
ORDER BY total ASC;


--Display second highest order amount.

SELECT MAX(total) AS second_highest
FROM am_orders
WHERE total < (
    SELECT MAX(total)
    FROM am_orders
);


