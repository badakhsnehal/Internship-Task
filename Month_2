 -- Find Total Number of Orders


-- Display total number of orders present in the table.

SELECT COUNT(*) AS total_orders
FROM am_orders;
--  Find Maximum Order Amount

SELECT MAX(total) AS highest_amount
FROM am_orders;

-- Find Minimum Order Amount

SELECT MIN(total) AS minimum_amount
FROM am_orders;

--  Find Average Order Amount


SELECT AVG(total) AS average_amount
FROM am_orders;

-- Calculate total sales amount.

SELECT SUM(total) AS total_sales
FROM am_orders;

--Show all unique products.

SELECT DISTINCT product_name
FROM am_orders;

--Display orders between 2020-11-12 and 2020-11-15.

SELECT *
FROM am_orders
WHERE order_date BETWEEN '2020-11-12' AND '2020-11-15';


--Display products starting with 'b'.

SELECT *
FROM am_orders
WHERE product_name LIKE 'b%';


--Display all UPI payment orders.

SELECT *
FROM am_orders
WHERE payment_method = 'UPI';

--Display orders having amount greater than 100.

SELECT *
FROM am_orders
WHERE total > 100;


--Count orders according to payment method.

SELECT payment_method, COUNT(*) AS total_orders
FROM am_orders
GROUP BY payment_method;

--Find total sales of each product.

SELECT product_name, SUM(total) AS total_sales
FROM am_orders
GROUP BY product_name;

--Display products whose total sales are greater than 100.

SELECT product_name, SUM(total) AS total_sales
FROM am_orders
GROUP BY product_name
HAVING SUM(total) > 100;


