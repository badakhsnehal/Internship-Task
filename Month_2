-- DDL -> data defination language it give defination how will data struture
drop table am_orders;
create table am_orders(
order_id  int NOT NULL UNIQUE  DEFAULT,-- constraint 1
order_date date,
product_name varchar(50),
total int ,
payment_method varchar(20) check (payment_method in ('UPI' , 'Credit Card')) default 'UPI'-- check constraint
);
